BASE_URL=http://localhost:8080/buffet-chay
PUBLIC_BASE_URL=http://localhost:8080/buffet-chay

# VietQR direct bank transfer
# Bank ID examples: mbbank, vietcombank, techcombank, acb, bidv, vietinbank
VIETQR_ENABLED=1
VIETQR_BANK_ID=vietcombank
VIETQR_ACCOUNT_NO=STK
VIETQR_ACCOUNT_NAME=TÊN CHỦ TÀI KHOẢN
VIETQR_TEMPLATE=compact2

# MongoDB analytics mirror
MONGO_ENABLED=0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=buffet_chay_analytics

# Password reset email
# Requires PHP mail/sendmail or SMTP relay configured on the web server.
MAIL_FROM=no-reply@buffet-chay.local
MAIL_FROM_NAME=Buffet Chay An Lac
PASSWORD_RESET_MINUTES=15
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
